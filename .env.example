# Docker Hub configuration
DOCKERHUB_USERNAME=your_dockerhub_username
APP_NAME=flasky
IMAGE_TAG=latest

# Application configuration
DATABASE=/app/data/flasky.db
FLASK_COVERAGE=

# GitHub Secrets required (set in repository secrets):
# DOCKERHUB_USERNAME
# DOCKERHUB_TOKEN
# VM_HOST
# VM_USER
# SSH_PRIVATE_KEY